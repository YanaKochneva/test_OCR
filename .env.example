# Local OCR by default. External review must be enabled explicitly.
DOCPIPE_OFFLINE=true
DOCPIPE_IMAGE_OCR=direct
DOCPIPE_REVIEW_ENABLED=false
DOCPIPE_REQUIRE_API_KEY=false
