include README.md LICENSES.md requirements.txt constraints.txt Dockerfile .dockerignore
include config.example.yaml .env.example
include process_documents.ipynb
recursive-include configs *.yaml
recursive-include deploy *.yml
recursive-include docs *.md
recursive-include scripts *.py
recursive-include src/docpipe/assets *.ttf *.txt
prune data
prune reports
prune models
prune .qa-deps
prune .test-deps
global-exclude __pycache__ *.py[cod] *.log *.tmp
