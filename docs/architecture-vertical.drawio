<mxfile host="app.diagrams.net" modified="2026-10-08T00:00:00.000Z" agent="Codex" version="24.7.17">
  <diagram id="docpipe-architecture" name="DocPipe — вертикальная архитектура">
    <mxGraphModel dx="1200" dy="1900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="1840" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="DocPipe — текущая архитектура" style="text;html=1;strokeColor=none;fillColor=none;fontSize=24;fontStyle=1;fontColor=#14233B;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="230" y="20" width="660" height="42" as="geometry"/></mxCell>

        <mxCell id="input" value="&lt;b&gt;Входной документ&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#55708F&quot;&gt;PDF или изображение: PNG, JPG, TIFF, BMP, WEBP&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#5BC47A;fillColor=#E8F8ED;fontColor=#17304E;strokeWidth=1.5;arcSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="85" width="460" height="70" as="geometry"/></mxCell>
        <mxCell id="ui" value="&lt;b&gt;Веб-интерфейс&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#55708F&quot;&gt;HTML + JavaScript, отдаётся самим API&lt;br&gt;загрузка файла · выбор DOCX · прогресс · скачивание ZIP&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#5BC47A;fillColor=#E8F8ED;fontColor=#17304E;strokeWidth=1.5;arcSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="175" width="460" height="82" as="geometry"/></mxCell>
        <mxCell id="api" value="&lt;b&gt;FastAPI + Uvicorn&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#55708F&quot;&gt;порт 8000 · X-API-Key · /v1/jobs · /readyz&lt;br&gt;проверка файла и параметров задания&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#1991FF;fillColor=#DDEEFF;fontColor=#17304E;strokeWidth=1.5;arcSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="280" width="460" height="82" as="geometry"/></mxCell>
        <mxCell id="manager" value="&lt;b&gt;JobManager&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#55708F&quot;&gt;очередь и статусы в памяти процесса · ограниченный размер&lt;br&gt;worker-потоки · сериализация обращений к OCR-движку · очистка по TTL&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#1991FF;fillColor=#DDEEFF;fontColor=#17304E;strokeWidth=1.5;arcSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="385" width="460" height="90" as="geometry"/></mxCell>
        <mxCell id="queue" value="&lt;b&gt;Очередь заданий в памяти&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#1991FF;fillColor=#EEF6FF;fontColor=#17304E;strokeWidth=1.5;arcSize=12;" vertex="1" parent="1"><mxGeometry x="395" y="495" width="330" height="52" as="geometry"/></mxCell>
        <mxCell id="worker" value="&lt;b&gt;Worker&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#55708F&quot;&gt;по умолчанию один worker; обрабатывает задание и собирает результат&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#1991FF;fillColor=#DDEEFF;fontColor=#17304E;strokeWidth=1.5;arcSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="570" width="460" height="70" as="geometry"/></mxCell>
        <mxCell id="normalize" value="&lt;b&gt;Нормализация входа&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#55708F&quot;&gt;PDF проходит дальше без преобразования; изображения собираются во временный PDF&lt;br&gt;Pillow + img2pdf&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#1991FF;fillColor=#DDEEFF;fontColor=#17304E;strokeWidth=1.5;arcSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="660" width="460" height="84" as="geometry"/></mxCell>
        <mxCell id="pdfium" value="&lt;b&gt;Подготовка страниц: pypdfium2&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#55708F&quot;&gt;анализ существующего текстового слоя PDF&lt;br&gt;растеризация страниц в изображения для OCR&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#1991FF;fillColor=#DDEEFF;fontColor=#17304E;strokeWidth=1.5;arcSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="765" width="460" height="82" as="geometry"/></mxCell>
        <mxCell id="engine" value="&lt;b&gt;Адаптер OCR: LayoutOcrEngine&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#55708F&quot;&gt;&lt;b&gt;Docling + RapidOCR — движок по умолчанию&lt;/b&gt;, распознавание таблиц&lt;br&gt;PP-Structure — дополнительный движок · Fake — только тесты&lt;br&gt;PaddleOCR-VL — адаптер пока не готов к работе&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#1991FF;fillColor=#DDEEFF;fontColor=#17304E;strokeWidth=1.5;arcSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="870" width="520" height="108" as="geometry"/></mxCell>
        <mxCell id="blocks" value="&lt;b&gt;Результат анализа страницы&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#55708F&quot;&gt;текст · таблицы и ячейки · фигуры · координаты и порядок элементов&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#1991FF;fillColor=#EEF6FF;fontColor=#17304E;strokeWidth=1.5;arcSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="1005" width="460" height="72" as="geometry"/></mxCell>
        <mxCell id="post" value="&lt;b&gt;Постобработка&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#55708F&quot;&gt;порядок чтения · привязка подписей к фигурам&lt;br&gt;очистка текста · настройка колонтитулов&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#1991FF;fillColor=#DDEEFF;fontColor=#17304E;strokeWidth=1.5;arcSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="1100" width="460" height="82" as="geometry"/></mxCell>
        <mxCell id="crops" value="&lt;b&gt;Извлечение изображений&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#55708F&quot;&gt;обрезка по bbox, сохранение в images/&lt;br&gt;Pillow&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#5BC47A;fillColor=#E8F8ED;fontColor=#17304E;strokeWidth=1.5;arcSize=12;" vertex="1" parent="1"><mxGeometry x="55" y="1100" width="230" height="82" as="geometry"/></mxCell>
        <mxCell id="ir" value="&lt;b&gt;Общий IR документа&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#55708F&quot;&gt;Pydantic · страницы, блоки, таблицы, рисунки и bbox&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#9A74E8;fillColor=#EEE8FF;fontColor=#17304E;strokeWidth=1.5;arcSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="1215" width="460" height="72" as="geometry"/></mxCell>
        <mxCell id="renderers" value="&lt;b&gt;Рендереры&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#55708F&quot;&gt;JSON · Markdown · HTML · DOCX&lt;br&gt;потоковый PDF · searchable PDF · позиционный PDF&lt;br&gt;python-docx · ReportLab · pikepdf · WeasyPrint (если установлен)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#9A74E8;fillColor=#EEE8FF;fontColor=#17304E;strokeWidth=1.5;arcSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="1320" width="520" height="112" as="geometry"/></mxCell>
        <mxCell id="verify" value="&lt;b&gt;Проверка и метрики&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#55708F&quot;&gt;IR · страницы · bbox · файлы · качество результата&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#1991FF;fillColor=#DDEEFF;fontColor=#17304E;strokeWidth=1.5;arcSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="1460" width="460" height="72" as="geometry"/></mxCell>
        <mxCell id="zip" value="&lt;b&gt;ZIP-архив результата&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#55708F&quot;&gt;выбранные форматы · JSON · отчёт проверки · метрики · изображения&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#9A74E8;fillColor=#EEE8FF;fontColor=#17304E;strokeWidth=1.5;arcSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="1555" width="460" height="72" as="geometry"/></mxCell>
        <mxCell id="result" value="&lt;b&gt;Скачивание архива в браузере&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#5BC47A;fillColor=#E8F8ED;fontColor=#17304E;strokeWidth=1.5;arcSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="1650" width="460" height="58" as="geometry"/></mxCell>

        <mxCell id="cli" value="&lt;b&gt;CLI&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#55708F&quot;&gt;docpipe parse&lt;br&gt;запуск конвейера напрямую, в обход API-очереди&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#5BC47A;fillColor=#E8F8ED;fontColor=#17304E;strokeWidth=1.5;arcSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="650" width="230" height="84" as="geometry"/></mxCell>
        <mxCell id="config" value="&lt;b&gt;Конфигурация и секрет&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#55708F&quot;&gt;YAML + переменные DOCPIPE_*&lt;br&gt;API-ключ хранится в окружении&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#8996A5;fillColor=#F3F5F7;fontColor=#17304E;strokeWidth=1.5;arcSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="285" width="230" height="82" as="geometry"/></mxCell>
        <mxCell id="docker" value="&lt;b&gt;Развёртывание&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#55708F&quot;&gt;Docker Compose · Python 3.11&lt;br&gt;образы и модели загружаются при сборке&lt;br&gt;порт 8000 · том data/jobs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#8996A5;fillColor=#F3F5F7;fontColor=#17304E;strokeWidth=1.5;arcSize=12;" vertex="1" parent="1"><mxGeometry x="840" y="280" width="230" height="112" as="geometry"/></mxCell>
        <mxCell id="masknote" value="&lt;b&gt;Особенность текущего кода&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#8B641C&quot;&gt;Маска фигур вычисляется после анализа, но сейчас не подаётся обратно в OCR.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#D5A23D;fillColor=#FFF6DF;fontColor=#17304E;strokeWidth=1.5;arcSize=12;" vertex="1" parent="1"><mxGeometry x="840" y="890" width="230" height="100" as="geometry"/></mxCell>

