{
  "$defs": {
    "BBox": {
      "additionalProperties": false,
      "properties": {
        "x0": {
          "title": "X0",
          "type": "number"
        },
        "y0": {
          "title": "Y0",
          "type": "number"
        },
        "x1": {
          "title": "X1",
          "type": "number"
        },
        "y1": {
          "title": "Y1",
          "type": "number"
        }
      },
      "required": [
        "x0",
        "y0",
        "x1",
        "y1"
      ],
      "title": "BBox",
      "type": "object"
    },
    "Block": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/BlockType"
        },
        "bbox": {
          "$ref": "#/$defs/BBox"
        },
        "order": {
          "minimum": 0,
          "title": "Order",
          "type": "integer"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "lines": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Line"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lines"
        },
        "level": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Level"
        },
        "table": {
          "anyOf": [
            {
              "$ref": "#/$defs/TableData"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "figure": {
          "anyOf": [
            {
              "$ref": "#/$defs/FigureData"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Label"
        }
      },
      "required": [
        "id",
        "type",
        "bbox",
        "order"
      ],
      "title": "Block",
      "type": "object"
    },
    "BlockType": {
      "enum": [
        "text",
        "heading",
        "list_item",
        "table",
        "figure",
        "caption",
        "formula",
        "header",
        "footer",
        "page_number",
        "footnote",
        "other"
      ],
      "title": "BlockType",
      "type": "string"
    },
    "EngineInfo": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        },
        "models": {
          "items": {
            "$ref": "#/$defs/ModelInfo"
          },
          "title": "Models",
          "type": "array"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "EngineInfo",
      "type": "object"
    },
    "FigureData": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "title": "File",
          "type": "string"
        },
        "format": {
          "title": "Format",
          "type": "string"
        },
        "width_px": {
          "exclusiveMinimum": 0,
          "title": "Width Px",
          "type": "integer"
        },
        "height_px": {
          "exclusiveMinimum": 0,
          "title": "Height Px",
          "type": "integer"
        },
        "caption_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Caption Id"
        }
      },
      "required": [
        "file",
        "format",
        "width_px",
        "height_px"
      ],
      "title": "FigureData",
      "type": "object"
    },
    "Line": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "bbox": {
          "$ref": "#/$defs/BBox"
        }
      },
      "required": [
        "text",
        "bbox"
      ],
      "title": "Line",
      "type": "object"
    },
    "ModelInfo": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "title": "Role",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "weights_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weights Sha256"
        }
      },
      "required": [
        "role",
        "name"
      ],
      "title": "ModelInfo",
      "type": "object"
    },
    "Page": {
      "additionalProperties": false,
      "properties": {
        "index": {
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "width_pt": {
          "exclusiveMinimum": 0,
          "title": "Width Pt",
          "type": "number"
        },
        "height_pt": {
          "exclusiveMinimum": 0,
          "title": "Height Pt",
          "type": "number"
        },
        "rotation": {
          "default": 0,
          "title": "Rotation",
          "type": "integer"
        },
        "raster_dpi": {
          "exclusiveMinimum": 0,
          "title": "Raster Dpi",
          "type": "integer"
        },
        "size_px": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Size Px",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/PageStatus"
        },
        "text_layer": {
          "$ref": "#/$defs/TextLayerStatus"
        },
        "blocks": {
          "items": {
            "$ref": "#/$defs/Block"
          },
          "title": "Blocks",
          "type": "array"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "index",
        "width_pt",
        "height_pt",
        "raster_dpi",
        "size_px",
        "status",
        "text_layer"
      ],
      "title": "Page",
      "type": "object"
    },
    "PageStatus": {
      "enum": [
        "ok",
        "degraded",
        "failed"
      ],
      "title": "PageStatus",
      "type": "string"
    },
    "SourceInfo": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "title": "File",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/SourceType"
        }
      },
      "required": [
        "file",
        "sha256",
        "type"
      ],
      "title": "SourceInfo",
      "type": "object"
    },
    "SourceType": {
      "enum": [
        "pdf",
        "image"
      ],
      "title": "SourceType",
      "type": "string"
    },
    "TableCell": {
      "additionalProperties": false,
      "properties": {
        "row": {
          "minimum": 0,
          "title": "Row",
          "type": "integer"
        },
        "col": {
          "minimum": 0,
          "title": "Col",
          "type": "integer"
        },
        "rowspan": {
          "default": 1,
          "minimum": 1,
          "title": "Rowspan",
          "type": "integer"
        },
        "colspan": {
          "default": 1,
          "minimum": 1,
          "title": "Colspan",
          "type": "integer"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "bbox": {
          "$ref": "#/$defs/BBox"
        }
      },
      "required": [
        "row",
        "col",
        "text",
        "bbox"
      ],
      "title": "TableCell",
      "type": "object"
    },
    "TableData": {
      "additionalProperties": false,
      "properties": {
        "html": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Html"
        },
        "cells": {
          "items": {
            "$ref": "#/$defs/TableCell"
          },
          "title": "Cells",
          "type": "array"
        },
        "n_rows": {
          "default": 0,
          "minimum": 0,
          "title": "N Rows",
          "type": "integer"
        },
        "n_cols": {
          "default": 0,
          "minimum": 0,
          "title": "N Cols",
          "type": "integer"
        }
      },
      "title": "TableData",
      "type": "object"
    },
    "TextLayerStatus": {
      "enum": [
        "valid",
        "absent",
        "garbage"
      ],
      "title": "TextLayerStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/SourceInfo"
    },
    "engine": {
      "$ref": "#/$defs/EngineInfo"
    },
    "pages": {
      "items": {
        "$ref": "#/$defs/Page"
      },
      "title": "Pages",
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    },
    "timings": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Timings",
      "type": "object"
    }
  },
  "required": [
    "source",
    "engine"
  ],
  "title": "Document",
  "type": "object"
}
